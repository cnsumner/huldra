{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"command": "dart compile exe ./bin/main.dart -o ./build/huldra.exe",
			"windows": {
				"command": "dart compile exe --target-os=windows --target-arch=arm64 ./bin/main.dart -o ./build/huldra.exe"
			},
			"linux": {
				"command": "dart compile exe --target-os=linux --target-arch=arm64 ./bin/main.dart -o ./build/huldra"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "process",
			"command": "dart pub run build_runner watch",
			"problemMatcher": ["$dart-build_runner"],
			"group": "build",
			"label": "pub: build_runner watch"
		}
	]
}
